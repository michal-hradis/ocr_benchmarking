{"res": {"input_path": null, "page_index": null, "page_count": null, "width": 1500, "height": 620, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "paragraph_title", "block_content": "Evening Gazette", "block_bbox": [38, 38, 367, 84], "block_id": 0, "block_order": 1, "group_id": 0, "block_polygon_points": [[38.0, 38.0], [367.0, 38.0], [367.0, 84.0], [38.0, 84.0]]}, {"block_label": "text", "block_content": "Rain fell over the city for the third day while the river kept rising.", "block_bbox": [34, 119, 270, 212], "block_id": 1, "block_order": 2, "group_id": 1, "block_polygon_points": [[34.0, 119.0], [270.0, 119.0], [270.0, 212.0], [34.0, 212.0]]}, {"block_label": "text", "block_content": "The council met on Monday to discuss a new road along the northern hill.", "block_bbox": [521, 119, 819, 211], "block_id": 2, "block_order": 3, "group_id": 2, "block_polygon_points": [[521.0, 119.0], [819.0, 119.0], [819.0, 211.0], [521.0, 211.0]]}, {"block_label": "text", "block_content": "Shops near the bridge\nclosed early and moved\ntheir goods upstairs.", "block_bbox": [35, 243, 291, 335], "block_id": 3, "block_order": 4, "group_id": 3, "block_polygon_points": [[35.0, 243.0], [291.0, 243.0], [291.0, 335.0], [35.0, 335.0]]}, {"block_label": "text", "block_content": "A travelling circus\narrived at the market\nsquare with six horses.", "block_bbox": [1006, 119, 1245, 211], "block_id": 4, "block_order": 5, "group_id": 4, "block_polygon_points": [[1006.0, 119.0], [1245.0, 119.0], [1245.0, 211.0], [1006.0, 211.0]]}, {"block_label": "text", "block_content": "Members voted to fund the work next spring after a long debate.", "block_bbox": [521, 243, 775, 335], "block_id": 5, "block_order": 6, "group_id": 5, "block_polygon_points": [[521.0, 243.0], [775.0, 243.0], [775.0, 335.0], [521.0, 335.0]]}, {"block_label": "text", "block_content": "Tickets are sold at\nthe town hall from noon\nuntil late evening.", "block_bbox": [1006, 243, 1268, 335], "block_id": 6, "block_order": 7, "group_id": 6, "block_polygon_points": [[1006.0, 243.0], [1268.0, 243.0], [1268.0, 335.0], [1006.0, 335.0]]}], "layout_det_res": {"input_path": null, "page_index": null, "boxes": [{"cls_id": 17, "label": "paragraph_title", "score": 0.893623948097229, "coordinate": [38, 38, 367, 84], "order": 1, "polygon_points": [[38.0, 38.0], [367.0, 38.0], [367.0, 84.0], [38.0, 84.0]]}, {"cls_id": 22, "label": "text", "score": 0.9099506735801697, "coordinate": [34, 119, 270, 212], "order": 2, "polygon_points": [[34.0, 119.0], [270.0, 119.0], [270.0, 212.0], [34.0, 212.0]]}, {"cls_id": 22, "label": "text", "score": 0.901451051235199, "coordinate": [521, 119, 819, 211], "order": 3, "polygon_points": [[521.0, 119.0], [819.0, 119.0], [819.0, 211.0], [521.0, 211.0]]}, {"cls_id": 22, "label": "text", "score": 0.9067980051040649, "coordinate": [35, 243, 291, 335], "order": 4, "polygon_points": [[35.0, 243.0], [291.0, 243.0], [291.0, 335.0], [35.0, 335.0]]}, {"cls_id": 22, "label": "text", "score": 0.870894730091095, "coordinate": [1006, 119, 1245, 211], "order": 5, "polygon_points": [[1006.0, 119.0], [1245.0, 119.0], [1245.0, 211.0], [1006.0, 211.0]]}, {"cls_id": 22, "label": "text", "score": 0.8694819808006287, "coordinate": [521, 243, 775, 335], "order": 6, "polygon_points": [[521.0, 243.0], [775.0, 243.0], [775.0, 335.0], [521.0, 335.0]]}, {"cls_id": 22, "label": "text", "score": 0.8684020042419434, "coordinate": [1006, 243, 1268, 335], "order": 7, "polygon_points": [[1006.0, 243.0], [1268.0, 243.0], [1268.0, 335.0], [1006.0, 335.0]]}]}}}