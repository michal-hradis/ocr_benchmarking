#!/usr/bin/env python3
"""Fake `vllm serve`: an OpenAI-compatible chat completions server on the loopback interface that
"generates" a fixed output chosen by the gray level of the page image's top-left corner
(../README.md). It checks the command line and every request as the adapter must send them."""

import base64
import io
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from PIL import Image

HERE = Path(__file__).resolve().parent
PROMPT = "<image>document parsing."
CONTEXT = 32768


def news(limit):
    blocks = [
        f"<|det|>text [50, {n * 9}, 950, {n * 9 + 8}]<|/det|>Line {n} of a very long newspaper page.\n"
        for n in range(1, 101)
    ]
    text = "".join(blocks)
    while len(text) < limit:
        text += "Line 100 of a very long newspaper page.\n"
    return text[:limit], "length"


def output(gray, limit):
    if gray > 190:  # 200
        return (HERE.parent.parent / "output.txt").read_text(encoding="utf-8"), "stop"
    if gray > 125:  # 150
        return "This page has no layout tags.", "stop"
    if gray > 90:  # 100
        return news(limit)
    if gray > 75:  # 80
        return "<|det|>text [0, 0, 999, 999]<|/det|>Cut off", "abort"
    return "", "stop"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.reply(200 if self.path == "/health" else 404, {})

    def do_POST(self):
        assert self.path == "/v1/chat/completions"
        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        (message,) = request["messages"]
        text_part, image_part = message["content"]
        assert message["role"] == "user" and text_part == {"type": "text", "text": PROMPT}
        assert request["model"] == "unlimited-ocr"
        assert request["temperature"] == 0.0 and request["skip_special_tokens"] is False
        assert request["vllm_xargs"] == {"ngram_size": 35, "window_size": 128}
        url = image_part["image_url"]["url"]
        assert image_part["type"] == "image_url" and url.startswith("data:image/png;base64,")
        image = Image.open(io.BytesIO(base64.b64decode(url.split(",", 1)[1]))).convert("L")
        gray = image.getpixel((image.width // 40, image.height // 40))
        if 35 < gray < 65:  # 50: a request error
            return self.reply(500, {"error": {"message": "fake CUDA out of memory"}})
        if gray < 35:  # 20: the server dies
            os._exit(1)
        prompt = (image.width // 16) * (image.height // 16) + len(PROMPT)
        # vLLM 0.26 generates up to max_tokens, at most to the end of the context (its default).
        limit = min(request.get("max_tokens") or CONTEXT, CONTEXT - prompt)
        text, reason = output(gray, limit)
        self.reply(
            200,
            {
                "choices": [{"message": {"content": text}, "finish_reason": reason}],
                "usage": {"prompt_tokens": prompt, "completion_tokens": len(text)},
            },
        )


def main():
    args = sys.argv[1:]
    assert args[0] == "serve" and args[1].endswith("07dea832e22aefee32ad281d4b80551282e1c168")
    assert args[args.index("--host") + 1] == "127.0.0.1"
    assert args[args.index("--max-model-len") + 1] == str(CONTEXT)
    assert "NGramPerReqLogitsProcessor" in args[args.index("--logits-processors") + 1]
    if os.environ.get("FAKE_VLLM_EXIT"):
        print("fake vLLM start-up failure", flush=True)
        sys.exit(3)
    port = int(args[args.index("--port") + 1])
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
