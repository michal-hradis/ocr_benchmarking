#!/usr/bin/env python3
"""Fake `vllm serve`: an OpenAI-compatible chat completions server on the loopback interface that
"generates" a fixed output chosen by the gray level of the page image's top-left corner (../README.md).
It checks the command line and every request as the adapter must send them."""

import base64
import io
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from PIL import Image

HERE = Path(__file__).resolve().parent
REVISION = "c3886ff00bb037ce7da24988c9eafaf1fe2bed72"
PROMPT = (HERE.parents[4] / "engines" / "nanonets-ocr2" / "prompt.txt").read_text(encoding="utf-8")
CONTEXT = 32768
MAX_IMAGE_TOKENS = 16384  # max_pixels 12,845,056 / (28 x 28)


def news(limit):
    text = "".join(f"Line {n} of a very long newspaper page.\n\n" for n in range(1, 101))
    while len(text) < limit:
        text += "Line 100 of a very long newspaper page.\n"
    return text[:limit], "length"


def output(gray, limit):
    if gray > 190:  # 200
        return (HERE.parent.parent / "page.md").read_text(encoding="utf-8"), "stop"
    if gray > 90:  # 100
        return news(limit)
    if gray > 75:  # 80
        return "Cut off", "abort"
    return "", "stop"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, status, body):
        data = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        self.reply(200 if self.path == "/health" else 404, {})

    def do_POST(self):
        assert self.path == "/v1/chat/completions"
        request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        (message,) = request["messages"]  # no system message: the chat template adds it
        assert message["role"] == "user"
        image_part, text_part = message["content"]  # the image, then the prompt
        assert text_part == {"type": "text", "text": PROMPT}
        assert request["model"] == "nanonets-ocr2"
        assert (request["temperature"], request["repetition_penalty"]) == (0.0, 1.05)
        assert request["seed"] == 0
        assert set(request) == {
            "model", "messages", "temperature", "max_tokens", "repetition_penalty", "seed"
        }  # fmt: skip
        url = image_part["image_url"]["url"]
        assert image_part["type"] == "image_url" and url.startswith("data:image/png;base64,")
        image = Image.open(io.BytesIO(base64.b64decode(url.split(",", 1)[1]))).convert("L")
        gray = image.getpixel((image.width // 40, image.height // 40))
        if 35 < gray < 65:  # 50: a request error
            return self.reply(500, {"error": {"message": "fake CUDA out of memory"}})
        if gray < 35:  # 20: the server dies
            os._exit(1)
        tokens = min((image.width // 28) * (image.height // 28), MAX_IMAGE_TOKENS)
        prompt = tokens + 150
        # vLLM generates up to max_tokens, at most to the end of the context.
        limit = min(request["max_tokens"], CONTEXT - prompt)
        text, reason = output(gray, limit)
        self.reply(
            200,
            {
                "choices": [{"message": {"content": text}, "finish_reason": reason}],
                "usage": {"prompt_tokens": prompt, "completion_tokens": len(text)},
            },
        )


def main():
    args = sys.argv[1:]
    assert args[0] == "serve"
    assert Path(args[1]).name == REVISION
    assert Path(args[1]).parent.name == "Nanonets-OCR2-3B"
    assert args[args.index("--host") + 1] == "127.0.0.1"
    assert args[args.index("--max-model-len") + 1] == str(CONTEXT)
    assert args[args.index("--limit-mm-per-prompt") + 1] == '{"image": 1}'
    assert args[args.index("--dtype") + 1] == "bfloat16"
    assert "--trust-remote-code" not in args
    if os.environ.get("FAKE_VLLM_EXIT"):
        print("fake vLLM start-up failure", flush=True)
        sys.exit(3)
    port = int(args[args.index("--port") + 1])
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
